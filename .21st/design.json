  "decisions": [
    {
      "id": "homepage-statement-reveal-bento",
      "decision": "Conserver sur la page d'accueil une déclaration courte révélée ligne par ligne, suivie d'une grille Bento asymétrique fondée uniquement sur des informations vérifiables.",
      "rationale": "Direction explicitement choisie par le client le 25 août 2026 ; elle renforce le rythme éditorial sans réintroduire de chiffres ou de promesses non sourcés."
    },
    {
      "id": "training-page-editorial-photo-led",
      "decision": "Traiter la page formation comme un récit éditorial premium : hero asymétrique, photographie métier structurante, sommaire d'ancrage, parcours linéaire et programme en accordéon, avec un contraste vert nuit, orange et crème.",
      "rationale": "Direction demandée et validée implicitement par la fourniture des deux photographies le 25 août 2026. Les images restent dans des cadres 3:2 afin de préserver leur qualité source, et les contenus évitent toute garantie non vérifiée."
    },
    {
      "id": "global-header-variable-font",
      "decision": "Utiliser un header flottant compact avec navigation typographique à graisse variable, état actif orange, CTA direct vers le parcours et menu mobile plein écran accessible.",
      "rationale": "Direction explicitement demandée le 25 août 2026. Geist Sans est chargé comme fonte variable pour rendre l'effet réel ; les animations respectent la préférence de réduction des mouvements."
    },
    {
      "id": "global-footer-brand-finale",
      "decision": "Conclure toutes les pages par un footer de marque immersif : CTA éditorial, navigation réelle, preuves réglementaires vérifiées et signature typographique surdimensionnée, dans un conteneur vert nuit à sommet arrondi.",
      "rationale": "Direction explicitement demandée le 25 août 2026. Le contenu reste rendu côté serveur ; seule l'apparition progressive est hydratée et elle est neutralisée par la préférence de réduction des mouvements."
    },
    {
      "id": "journal-six-article-seo-cluster",
      "decision": "Structurer le Journal comme un cluster de six dossiers SEO longs et vérifiés, illustrés par les photographies métier du client et couvrant orientation, financement, métier, formation, recrutement et prise de service.",
      "rationale": "Direction explicitement demandée le 25 août 2026. La grille éditoriale prolonge la DA vert nuit, orange et crème ; chaque publication doit rester sourcée et éviter toute promesse de durée, de financement ou d'emploi non démontrée."
    }
