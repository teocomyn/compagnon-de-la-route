# URL publique canonique
NEXT_PUBLIC_SITE_URL=https://compagnondelaroute.com

# Coordonnées affichées sur le site (laisser vide pour masquer)
NEXT_PUBLIC_CONTACT_EMAIL=contact@compagnondelaroute.com
NEXT_PUBLIC_CONTACT_PHONE=

# Envoi du formulaire par l'API Resend
CONTACT_FORM_MODE=disabled
RESEND_API_KEY=
CONTACT_TO_EMAIL=contact@compagnondelaroute.com
CONTACT_FROM_EMAIL=Compagnon de la Route <contact@compagnondelaroute.com>

# Mentions obligatoires à valider avant la mise en ligne définitive
LEGAL_PUBLICATION_DIRECTOR=
LEGAL_HOST_NAME=
LEGAL_HOST_ADDRESS=

# true si BOAZ conclut des contrats payants avec des particuliers, false sinon
CONSUMER_SALES_ENABLED=
CONSUMER_MEDIATOR_NAME=
CONSUMER_MEDIATOR_URL=

# Laisser désactivé tant que les pages éditoriales suspendues ne sont pas validées
ENABLE_EDITORIAL_CONTENT=false
